# Configuración opcional: docker compose up -d --build funciona sin este archivo.
VELORA_VERSION=0.22.1
# Vacío: contraseña aleatoria persistente en el volumen credentials.
# Conserva el valor existente si actualizas desde una instalación anterior.
VELORA_DB_PASSWORD=
# Ruta absoluta de TU servidor, con lectura para UID 1000/GID 100.
VELORA_MEDIA_PATH=../media
VELORA_OTA_PATH=../dist/ota
VELORA_BIND=0.0.0.0
VELORA_PORT=8640
# false solo para HTTP en una red privada; true cuando uses HTTPS.
VELORA_SECURE_COOKIES=false
VELORA_PUBLIC_URLS=
VELORA_TRUSTED_PROXIES=
VELORA_MIN_FREE_GB=5
VELORA_MAX_REMUX=2
VELORA_TZ=Europe/Madrid
